<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Card"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/tabs"
        maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <content jcr:primaryType="nt:unstructured"
                jcr:title="Content"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <fileReference jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Image"
                        fieldDescription=""
                        rootPath="/content/dam"
                        name="./fileReference"/>
                    <jcr:title jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Title"
                        fieldDescription="Exported as content.title."
                        name="./jcr:title"/>
                    <subtitle jcr:primaryType="nt:unstructured"
                        sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                        fieldLabel="Subtitle"
                        fieldDescription=""
                        name="./subtitle"
                        useFixedInlineToolbar="{Boolean}true">
                        <rtePlugins jcr:primaryType="nt:unstructured">
                            <format jcr:primaryType="nt:unstructured" features="bold,italic"/>
                            <justify jcr:primaryType="nt:unstructured" features="-"/>
                            <links jcr:primaryType="nt:unstructured" features="modifylink,unlink"/>
                            <lists jcr:primaryType="nt:unstructured" features="*"/>
                            <paraformat jcr:primaryType="nt:unstructured" features="*"/>
                            <undo jcr:primaryType="nt:unstructured" features="*"/>
                        </rtePlugins>
                        <uiSettings jcr:primaryType="nt:unstructured">
                            <cui jcr:primaryType="nt:unstructured">
                                <inline jcr:primaryType="nt:unstructured"
                                    toolbar="[format#bold,format#italic,#justify,#lists,links#modifylink,links#unlink,#paraformat]">
                                    <popovers jcr:primaryType="nt:unstructured">
                                        <justify jcr:primaryType="nt:unstructured" items="[justify#justifyleft,justify#justifycenter,justify#justifyright]" ref="justify"/>
                                        <lists jcr:primaryType="nt:unstructured" items="[lists#unordered,lists#ordered,lists#outdent,lists#indent]" ref="lists"/>
                                        <paraformat jcr:primaryType="nt:unstructured" items="paraformat:getFormats:paraformat-pulldown" ref="paraformat"/>
                                    </popovers>
                                </inline>
                            </cui>
                        </uiSettings>
                    </subtitle>
                    <link jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Link"
                        fieldDescription="Target page or external URL."
                        rootPath="/content"
                        name="./link"/>
                    <buttonLabel jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Button label"
                        fieldDescription=""
                        name="./buttonLabel"/>
                </items>
            </content>
            <style jcr:primaryType="nt:unstructured"
                jcr:title="Style"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <titleVariant jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Title variant"
                        fieldDescription=""
                        name="./titleVariant">
                        <items jcr:primaryType="nt:unstructured">
                            <titleLarge jcr:primaryType="nt:unstructured"
                                        text="Large"
                                        value="titleLarge"/>
                            <titleMedium jcr:primaryType="nt:unstructured"
                                        text="Medium"
                                        value="titleMedium"
                                        selected="{Boolean}true"/>
                            <titleSmall jcr:primaryType="nt:unstructured"
                                        text="Small"
                                        value="titleSmall"/>
                        </items>
                    </titleVariant>
                    <textTransform jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Text transform"
                        fieldDescription=""
                        name="./textTransform">
                        <items jcr:primaryType="nt:unstructured">
                            <none jcr:primaryType="nt:unstructured"
                                        text="None"
                                        value="none"
                                        selected="{Boolean}true"/>
                            <uppercase jcr:primaryType="nt:unstructured"
                                        text="Uppercase"
                                        value="uppercase"/>
                            <capitalize jcr:primaryType="nt:unstructured"
                                        text="Capitalize"
                                        value="capitalize"/>
                        </items>
                    </textTransform>
                    <cardType jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Card type"
                        fieldDescription=""
                        name="./cardType">
                        <items jcr:primaryType="nt:unstructured">
                            <stacked jcr:primaryType="nt:unstructured"
                                        text="Stacked"
                                        value="stacked"
                                        selected="{Boolean}true"/>
                            <horizontal jcr:primaryType="nt:unstructured"
                                        text="Horizontal"
                                        value="horizontal"/>
                            <overlay jcr:primaryType="nt:unstructured"
                                        text="Overlay"
                                        value="overlay"/>
                        </items>
                    </cardType>
                    <isSubtitleRichText jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                        text="Subtitle is rich text"
                        fieldDescription=""
                        name="./isSubtitleRichText"
                        value="true"
                        uncheckedValue="false"
                        checked="{Boolean}true"
                        deleteHint="{Boolean}true"/>
                </items>
            </style>
        </items>
    </content>
</jcr:root>
