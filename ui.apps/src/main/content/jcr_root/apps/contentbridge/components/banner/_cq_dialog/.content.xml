<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Banner"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/tabs"
        maximized="{Boolean}true">
        <items jcr:primaryType="nt:unstructured">
            <content jcr:primaryType="nt:unstructured"
                jcr:title="Content"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <fileReference jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Background image"
                        fieldDescription="DAM asset rendered behind the banner content."
                        rootPath="/content/dam"
                        name="./fileReference"/>
                    <title jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Title"
                        fieldDescription=""
                        name="./title"/>
                    <titleVariant jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Title variant"
                        fieldDescription=""
                        name="./titleVariant">
                        <items jcr:primaryType="nt:unstructured">
                            <titleLarge jcr:primaryType="nt:unstructured"
                                        text="Large"
                                        value="titleLarge"
                                        selected="{Boolean}true"/>
                            <titleMedium jcr:primaryType="nt:unstructured"
                                        text="Medium"
                                        value="titleMedium"/>
                            <titleSmall jcr:primaryType="nt:unstructured"
                                        text="Small"
                                        value="titleSmall"/>
                        </items>
                    </titleVariant>
                    <subtitle jcr:primaryType="nt:unstructured"
                        sling:resourceType="cq/gui/components/authoring/dialog/richtext"
                        fieldLabel="Subtitle"
                        fieldDescription="Rich text. Exported verbatim with isSubtitleRichText=true."
                        name="./subtitle"
                        useFixedInlineToolbar="{Boolean}true">
                        <rtePlugins jcr:primaryType="nt:unstructured">
                            <format jcr:primaryType="nt:unstructured" features="bold,italic"/>
                            <justify jcr:primaryType="nt:unstructured" features="-"/>
                            <links jcr:primaryType="nt:unstructured" features="modifylink,unlink"/>
                            <lists jcr:primaryType="nt:unstructured" features="*"/>
                            <paraformat jcr:primaryType="nt:unstructured" features="*"/>
                            <undo jcr:primaryType="nt:unstructured" features="*"/>
                        </rtePlugins>
                        <uiSettings jcr:primaryType="nt:unstructured">
                            <cui jcr:primaryType="nt:unstructured">
                                <inline jcr:primaryType="nt:unstructured"
                                    toolbar="[format#bold,format#italic,#justify,#lists,links#modifylink,links#unlink,#paraformat]">
                                    <popovers jcr:primaryType="nt:unstructured">
                                        <justify jcr:primaryType="nt:unstructured" items="[justify#justifyleft,justify#justifycenter,justify#justifyright]" ref="justify"/>
                                        <lists jcr:primaryType="nt:unstructured" items="[lists#unordered,lists#ordered,lists#outdent,lists#indent]" ref="lists"/>
                                        <paraformat jcr:primaryType="nt:unstructured" items="paraformat:getFormats:paraformat-pulldown" ref="paraformat"/>
                                    </popovers>
                                </inline>
                            </cui>
                        </uiSettings>
                    </subtitle>
                </items>
            </content>
            <cta jcr:primaryType="nt:unstructured"
                jcr:title="Call to action"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <showButton jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                        text="Show button"
                        fieldDescription="When off, the button properties are omitted from the JSON."
                        name="./showButton"
                        value="true"
                        uncheckedValue="false"
                        deleteHint="{Boolean}true"/>
                    <buttonLabel jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Button label"
                        fieldDescription=""
                        name="./buttonLabel"/>
                    <linkTo jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Button link"
                        fieldDescription="Page path, external URL or anchor."
                        rootPath="/content"
                        name="./linkTo"/>
                    <buttonIcon jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Button icon"
                        fieldDescription="Icon token understood by the consuming client."
                        name="./buttonIcon"/>
                </items>
            </cta>
            <layout jcr:primaryType="nt:unstructured"
                jcr:title="Layout"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                margin="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <horizontalAlignment jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Horizontal alignment"
                        fieldDescription=""
                        name="./horizontalAlignment">
                        <items jcr:primaryType="nt:unstructured">
                            <left jcr:primaryType="nt:unstructured"
                                        text="Left"
                                        value="left"
                                        selected="{Boolean}true"/>
                            <center jcr:primaryType="nt:unstructured"
                                        text="Center"
                                        value="center"/>
                            <right jcr:primaryType="nt:unstructured"
                                        text="Right"
                                        value="right"/>
                        </items>
                    </horizontalAlignment>
                    <verticalAlignment jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Vertical alignment"
                        fieldDescription=""
                        name="./verticalAlignment">
                        <items jcr:primaryType="nt:unstructured">
                            <top jcr:primaryType="nt:unstructured"
                                        text="Top"
                                        value="top"/>
                            <middle jcr:primaryType="nt:unstructured"
                                        text="Middle"
                                        value="middle"
                                        selected="{Boolean}true"/>
                            <bottom jcr:primaryType="nt:unstructured"
                                        text="Bottom"
                                        value="bottom"/>
                        </items>
                    </verticalAlignment>
                    <contentAlignment jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Content alignment"
                        fieldDescription=""
                        name="./contentAlignment">
                        <items jcr:primaryType="nt:unstructured">
                            <left jcr:primaryType="nt:unstructured"
                                        text="Left"
                                        value="left"
                                        selected="{Boolean}true"/>
                            <center jcr:primaryType="nt:unstructured"
                                        text="Center"
                                        value="center"/>
                            <right jcr:primaryType="nt:unstructured"
                                        text="Right"
                                        value="right"/>
                        </items>
                    </contentAlignment>
                    <isSubtitleRichText jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                        text="Subtitle is rich text"
                        fieldDescription=""
                        name="./isSubtitleRichText"
                        value="true"
                        uncheckedValue="false"
                        checked="{Boolean}true"
                        deleteHint="{Boolean}true"/>
                </items>
            </layout>
        </items>
    </content>
</jcr:root>
