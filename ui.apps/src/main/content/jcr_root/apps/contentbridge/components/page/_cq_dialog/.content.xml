<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured">
                <items jcr:primaryType="nt:unstructured">
                    <cbApp jcr:primaryType="nt:unstructured"
                        jcr:title="ContentBridge App"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <appId jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="App ID"
                                fieldDescription="Identifier emitted as the top-level &quot;id&quot; and &quot;meta.id&quot;. Setting this property marks the page as the app root."
                                required="{Boolean}true"
                                name="./appId"/>
                            <appTitle jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="App title"
                                fieldDescription="Emitted as meta.title. Falls back to the page title."
                                name="./appTitle"/>
                            <appType jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="App type"
                                name="./appType">
                                <items jcr:primaryType="nt:unstructured">
                                    <mobilev2 jcr:primaryType="nt:unstructured" text="Mobile v2" value="mobile-v2" selected="{Boolean}true"/>
                                    <web jcr:primaryType="nt:unstructured" text="Web" value="web"/>
                                    <kiosk jcr:primaryType="nt:unstructured" text="Kiosk" value="kiosk"/>
                                </items>
                            </appType>
                            <useCart jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                text="Enable cart"
                                name="./useCart"
                                value="{Boolean}true"
                                uncheckedValue="{Boolean}false"
                                deleteHint="{Boolean}true"/>
                            <navigationHeading jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/heading"
                                level="{Long}3"
                                text="Navigation"/>
                            <loginScreen jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Login screen"
                                emptyText="login"
                                name="./loginScreen"/>
                            <registrationScreen jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Registration screen"
                                emptyText="registration"
                                name="./registrationScreen"/>
                            <profileScreen jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Profile screen"
                                emptyText="user-details"
                                name="./profileScreen"/>
                            <authorizedMenu jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                                fieldLabel="Authorized menu"
                                fieldDescription="Screens shown only to signed-in users."
                                composite="{Boolean}false">
                                <field jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    name="./authorizedMenu"/>
                            </authorizedMenu>
                        </items>
                    </cbApp>
                    <cbScreen jcr:primaryType="nt:unstructured"
                        jcr:title="ContentBridge Screen"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <screenName jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Screen key"
                                fieldDescription="Key used in the &quot;screens&quot; map and in meta.navigation.menu. Defaults to the page title."
                                name="./screenName"/>
                            <screenIcon jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                fieldLabel="Screen icon"
                                fieldDescription="Icon token, e.g. home or file-document."
                                emptyText="file-document"
                                name="./screenIcon"/>
                            <excludeFromApp jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                text="Exclude this page from the JSON export"
                                name="./excludeFromApp"
                                value="{Boolean}true"
                                uncheckedValue="{Boolean}false"
                                deleteHint="{Boolean}true"/>
                        </items>
                    </cbScreen>
                    <cbBranding jcr:primaryType="nt:unstructured"
                        jcr:title="ContentBridge Branding"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <logo jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Logo"
                                rootPath="/content/dam"
                                name="./contentbridge/branding/logo"/>
                            <dark_logo jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                fieldLabel="Logo (dark mode)"
                                rootPath="/content/dam"
                                name="./contentbridge/branding/dark_logo"/>
                            <variant jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/select"
                                fieldLabel="Variant"
                                name="./contentbridge/branding/variant">
                                <items jcr:primaryType="nt:unstructured">
                                    <basic jcr:primaryType="nt:unstructured" text="Basic" value="basic"/>
                                    <advanced jcr:primaryType="nt:unstructured" text="Advanced" value="advanced" selected="{Boolean}true"/>
                                </items>
                            </variant>
                            <roundness jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                                fieldLabel="Corner roundness"
                                min="{Long}0"
                                max="{Long}32"
                                value="{Long}4"
                                name="./contentbridge/branding/roundness"/>
                            <roundnessTypeHint jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                                name="./contentbridge/branding/roundness@TypeHint"
                                value="Long"/>
                            <lightHeading jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/heading"
                                level="{Long}3"
                                text="Light theme"/>
                            <primaryColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Primary"
                                name="./contentbridge/branding/primaryColor"
                                value="#000000"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <secondaryColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Secondary"
                                name="./contentbridge/branding/secondaryColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <tertiaryColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Tertiary"
                                name="./contentbridge/branding/tertiaryColor"
                                value="#005971"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <textColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Text"
                                name="./contentbridge/branding/textColor"
                                value="#000000"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <backgroundColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Background"
                                name="./contentbridge/branding/backgroundColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <topBarBackgroundColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Top bar background"
                                name="./contentbridge/branding/topBarBackgroundColor"
                                value="#005971"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <topBarTextColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Top bar text"
                                name="./contentbridge/branding/topBarTextColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <topBarAccentColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Top bar accent"
                                name="./contentbridge/branding/topBarAccentColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <bottomBarBackgroundColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Bottom bar background"
                                name="./contentbridge/branding/bottomBarBackgroundColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <bottomBarTextColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Bottom bar text"
                                name="./contentbridge/branding/bottomBarTextColor"
                                value="#000000"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <bottomBarAccentColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Bottom bar accent"
                                name="./contentbridge/branding/bottomBarAccentColor"
                                value="#000000"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <darkHeading jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/heading"
                                level="{Long}3"
                                text="Dark theme"/>
                            <dark_primaryColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Primary"
                                name="./contentbridge/branding/dark_primaryColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_secondaryColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Secondary"
                                name="./contentbridge/branding/dark_secondaryColor"
                                value="#000000"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_tertiaryColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Tertiary"
                                name="./contentbridge/branding/dark_tertiaryColor"
                                value="#00bcd4"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_textColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Text"
                                name="./contentbridge/branding/dark_textColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_backgroundColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Background"
                                name="./contentbridge/branding/dark_backgroundColor"
                                value="#121212"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_topBarBackgroundColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Top bar background"
                                name="./contentbridge/branding/dark_topBarBackgroundColor"
                                value="#00303a"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_topBarTextColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Top bar text"
                                name="./contentbridge/branding/dark_topBarTextColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_topBarAccentColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Top bar accent"
                                name="./contentbridge/branding/dark_topBarAccentColor"
                                value="#00bcd4"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_bottomBarBackgroundColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Bottom bar background"
                                name="./contentbridge/branding/dark_bottomBarBackgroundColor"
                                value="#1a1a1a"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_bottomBarTextColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Bottom bar text"
                                name="./contentbridge/branding/dark_bottomBarTextColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                            <dark_bottomBarAccentColor jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/colorfield"
                                fieldLabel="Dark - Bottom bar accent"
                                name="./contentbridge/branding/dark_bottomBarAccentColor"
                                value="#ffffff"
                                showSwatches="{Boolean}true"
                                showProperties="{Boolean}true"
                                showDefaultColors="{Boolean}true"
                                autogenerateColors="shades"
                                variant="swatch"/>
                        </items>
                    </cbBranding>
                    <cbExtras jcr:primaryType="nt:unstructured"
                        jcr:title="ContentBridge Extras"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <hint jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/text"
                                text="Paste raw JSON. Invalid JSON is logged and exported as an empty object/array rather than breaking the response."/>
                            <integrationsJson jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                fieldLabel="integrations (JSON object)"
                                rows="{Long}10"
                                name="./contentbridge/extras/integrationsJson"/>
                            <profileViewerJson jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                fieldLabel="profileViewer (JSON object)"
                                rows="{Long}10"
                                name="./contentbridge/extras/profileViewerJson"/>
                            <productsJson jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                fieldLabel="products (JSON array)"
                                rows="{Long}10"
                                name="./contentbridge/extras/productsJson"/>
                        </items>
                    </cbExtras>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
