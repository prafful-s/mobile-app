{
  "match": ["button", "cta"],
  "component": "button",
  "fields": [
    { "target": "label", "first": ["linkText", "buttonText", "text", "jcr:title"] },
    { "target": "linkTo", "first": ["link", "btn-link", "href"] },
    { "target": "variant", "first": ["linkType", "ctastyle", "style"], "default": "button" },
    { "target": "horizontalAlignment", "from": "alignment", "default": "left" },
    { "target": "uppercase", "from": "textUppercase", "type": "boolean" },
    { "target": "textColor", "from": "textColor" },
    { "target": "backgroundColor", "from": "backgroundColor" },
    { "target": "borderColor", "from": "borderColor" }
  ]
}
