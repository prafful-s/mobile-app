{
  "match": ["product-card"],
  "component": "banner",
  "skeleton": true,
  "contentFragmentRef": "contentFragmentFolder",
  "fields": [
    { "target": "image", "from": "productImage" },
    { "target": "title", "from": "productName" },
    { "target": "subtitle", "nullable": true },
    { "target": "linkTo", "from": "link", "type": "path", "nullable": true },
    { "target": "opacity", "const": 0 },
    { "target": "showButton", "const": true },
    { "target": "buttonLabel", "from": "buttonText", "nullable": true },
    {
      "target": "buttonVariant",
      "from": "ctastyle",
      "map": { "button": "contained", "cta-button": "contained", "cta-link": "text" },
      "default": "contained"
    },
    { "target": "imageResize", "default": "cover" },
    { "target": "titleVariant", "const": "titleLarge" },
    { "target": "subtitleVariant", "const": "titleSmall" },
    { "target": "contentAlignment", "default": "left" },
    { "target": "verticalAlignment", "default": "middle" },
    { "target": "horizontalAlignment", "default": "left" }
  ],
  "styles": [
    { "target": "color", "const": "#FFF" },
    { "target": "height", "const": 200 }
  ]
}
