{
  "match": ["card"],
  "component": "card",
  "requires": "image",
  "fallback": {
    "component": "htmlText",
    "fields": [
      { "target": "text", "first": ["text", "richText", "jcr:text"] }
    ]
  },
  "fields": [
    { "target": "link",
      "extract": { "from": "text", "select": "a", "as": "attr", "attribute": "href" },
      "default": "#" },
    { "target": "image", "first": ["image", "fileReference", "imageRef"] },
    { "target": "imageResize", "from": "imageResize", "default": "contain" },
    { "target": "title", "extract": { "from": "text", "select": "h1, h2, h3, h4", "as": "text" } },
    { "target": "cardType", "from": "style",
      "map": {
        "": "stacked",
        "image-top": "stacked",
        "image-bottom": "stacked",
        "image-left": "image-text-one-line",
        "image-right": "image-text-one-line",
        "teaser-overlay": "overlay",
        "teaser-card": "partial-overlay",
        "icon-cards": "stacked",
        "*": "stacked"
      }, "default": "stacked" },
    { "target": "mobileImageResizeMode", "from": "imagestyle",
      "map": {
        "": "cover",
        "contain": "contain",
        "fill": "fill",
        "none": "contain",
        "scale-down": "contain",
        "compact-style": "contain",
        "*": "cover"
      }, "default": "cover" },
    { "target": "subtitle",
      "extract": { "from": "text", "select": "p:not(:has(a)), li", "as": "text", "all": true },
      "nullable": true },
    { "target": "titleVariant", "const": "titleLarge" },
    { "target": "subtitleVariant", "const": "titleMedium" },
    { "target": "titleFontWeight", "const": "regular" },
    { "target": "subtitleFontWeight", "const": "regular" }
  ],
  "styles": [
    { "target": "color", "from": "style",
      "map": { "teaser-overlay": "#ffffff", "*": "" }, "nullable": true }
  ]
}

