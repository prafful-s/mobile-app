{
  "match": ["hero", "banner", "masthead"],
  "component": "banner",
  "fields": [
    { "target": "image", "first": ["image", "fileReference", "imageRef"] },
    { "target": "title", "extract": { "from": "text", "select": "h1, h2", "as": "text" } },
    { "target": "titleVariant", "const": "titleLarge" },
    { "target": "subtitle",
      "extract": { "from": "text", "select": "p:not(:has(a))", "as": "html", "all": true },
      "nullable": true },
    { "target": "buttonLabel",
      "extract": { "from": "text", "select": "a", "as": "text" }, "nullable": true },
    { "target": "linkTo", "const": "#" },
    { "target": "buttonIcon", "const": "." },
    { "target": "showButton", "const": "true" },
    { "target": "horizontalAlignment", "const": "left" },
    { "target": "verticalAlignment", "const": " middle" },
    { "target": "contentAlignment", "const": "left" },
    { "target": "isSubtitleRichText", "const": "true" }
  ]
}
