{
  "match": ["new-arrival"],
  "component": "list",
  "skeleton": true,
  "contentFragmentFolderRef": {
    "property": "folder",
    "collect": [
      { "fields": ["category"], "injectAs": "_categories",
        "matchField": "sku", "matchAgainst": "skus" }
    ]
  },
  "fields": [
    { "target": "items", "from": "skus", "default": [] },
    { "target": "limit", "from": "limit", "type": "number", "default": 5 },
    { "target": "filter", "from": "_categories", "type": "categoryPath", "default": "" },
    { "target": "layout", "from": "layout",
      "map": { "horizontal": "horizontal", "vertical": "vertical/grid" },
      "default": "horizontal" },
    { "target": "listType", "from": "listType", "default": "productList" },
    { "target": "textColor", "from": "textColor", "default": "#BBB" },
    { "target": "imageWidth", "from": "imageWidth", "type": "number", "default": 120 },
    { "target": "itemHeight", "from": "itemHeight", "type": "number", "default": 120 },
    { "target": "itemsInRow", "from": "itemsInRow", "type": "number", "default": 1 },
    { "target": "itemRenderer", "from": "itemRenderer", "default": "stacked" },
    { "target": "filterProperty", "from": "filterProperty", "default": "Category" },
    { "target": "imageResizeMode", "from": "imageResizeMode", "default": "cover" },
    { "target": "titleFontWeight", "from": "titleFontWeight", "default": "regular" },
    { "target": "subtitleFontWeight", "from": "subtitleFontWeight", "default": "light" }
  ],
  "styles": [
    { "target": "gap", "from": "gap", "type": "number", "default": 12 },
    { "target": "marginHorizontal", "from": "marginHorizontal", "default": "12" }
  ]
}
