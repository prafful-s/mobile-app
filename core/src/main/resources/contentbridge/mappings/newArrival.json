{
  "match": ["new-arrival"],
  "component": "list",
  "skeleton": true,
  "ignoreExtras": ["*"],
  "fields": [
    { "target": "items", "const": ["product"] },
    { "target": "limit", "const": 5 },
    { "target": "filter", "const": "New" },
    { "target": "layout", "const": "horizontal" },
    { "target": "listType", "const": "productList" },
    { "target": "textColor", "const": "#BBB" },
    { "target": "imageWidth", "const": 120 },
    { "target": "itemHeight", "const": 120 },
    { "target": "itemsInRow", "const": 1 },
    { "target": "itemRenderer", "const": "stacked" },
    { "target": "filterProperty", "const": "Category" },
    { "target": "imageResizeMode", "const": "cover" },
    { "target": "titleFontWeight", "const": "regular" },
    { "target": "subtitleFontWeight", "const": "light" }
  ],
  "styles": [
    { "target": "gap", "const": 12 },
    { "target": "marginHorizontal", "const": "12" }
  ]
}
