{
  "match": ["new-arrival"],
  "component": "list",
  "fields": [
    { "target": "items", "from": "skus", "default": [] },
    { "target": "layout", "const": "vertical/grid" },
    { "target": "filter", "from": "folder", "type": "basename", "default": "New" },
    { "target": "filterProperty", "from": "filterProperty", "default": "Category" },
    { "target": "listType", "from": "listType", "default": "productList" },
    { "target": "itemRenderer", "from": "itemRenderer", "default": "image-text-one-line" },
    { "target": "itemsInRow", "from": "itemsInRow", "type": "number", "default": 1 },
    { "target": "textColor", "from": "textColor", "default": "#8B8B8B" },
    { "target": "titleFontWeight", "from": "titleFontWeight", "default": "regular" },
    { "target": "subtitleFontWeight", "from": "subtitleFontWeight", "default": "light" }
  ],
  "styles": [
    { "target": "gap", "from": "gap", "type": "number", "default": 12 },
    { "target": "marginHorizontal", "from": "marginHorizontal", "default": "12" }
  ]
}
