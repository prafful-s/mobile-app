{
  "match": ["productAddToCartButton"],
  "component": "productAddToCartButton",
  "skeleton": true,
  "customStyle": "mobileappproductaddtocartbuttonstyle",
  "ignoreExtras": ["*"],
  "fields": [
    { "target": "label", "from": "label", "default": "Add" },
    { "target": "variant", "from": "mobileappproductaddtocartbuttonvariant", "default": "text" },
    { "target": "alignment", "from": "mobileappproductaddtocartbuttonalignment", "default": "center" },
    { "target": "appearanceVariant", "from": "mobileappproductaddtocartbuttonappearancevariant", "default": "text-icon" }
  ]
}