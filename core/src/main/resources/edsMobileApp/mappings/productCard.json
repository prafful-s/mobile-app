{
  "match": ["product-card"],
  "component": "card",
  "contentFragmentRef": "contentFragmentFolder",
  "linkQuery": { "param": "productId", "from": "productSku" },
  "fields": [
    { "target": "link", "from": "link", "default": "#" },
    { "target": "image", "from": "productImage" },
    { "target": "imageResize", "from": "imageResize", "default": "contain" },
    { "target": "imageResize", "from": "mobileimagestyle" },
    { "target": "title", "from": "productName" },
    { "target": "cardType", "from": "mobilecardstyle",
      "map": { "one-line": "image-text-one-line", "below": "stacked" },
      "default": "stacked" },
    { "target": "subtitle", "from": "productDescription", "nullable": true },
    { "target": "showButton", "from": "mobileshowbutton", "type": "boolean" },
    { "target": "buttonLabel", "from": "buttonText" },
    { "target": "buttonVariant", "from": "ctastyle",
      "map": { "button": "contained", "button-secondary": "outlined", "button-dark": "contained-tonal",
               "*": "contained" } },
    { "target": "buttonVariant", "from": "mobilebuttonvariant" },
    { "target": "isSubtitleRichText", "const": true },
    { "target": "titleVariant", "const": "titleLarge" },
    { "target": "subtitleVariant", "const": "titleMedium" },
    { "target": "titleFontWeight", "const": "regular" },
    { "target": "subtitleFontWeight", "const": "regular" }
  ],
  "styles": [
    { "target": "marginLeft", "const": "30" },
    { "target": "marginRight", "const": "30" },
    { "target": "showBorder", "from": "addBorder", "type": "boolean" }
  ]
}
