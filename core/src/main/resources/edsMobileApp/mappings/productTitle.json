{
  "match": ["productTitle"],
  "component": "productTitle",
  "skeleton": true,
  "customStyle": "mobileappproducttitlestyle",
  "fields": [
    { "target": "size", "from": "mobileappproducttitlesize", "default": "medium" },
    { "target": "weight", "from": "mobileappproducttitleweight", "default": "bold" },
    { "target": "textAlignment", "from": "mobileappproducttitlealignment", "default": "left" }
  ],
  "styles": [
    { "target": "color", "from": "color" }
  ]
}
