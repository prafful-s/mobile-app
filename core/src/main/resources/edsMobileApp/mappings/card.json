{
  "match": ["card"],
  "component": "card",
  "requires": "image",
  "fallback": {
    "component": "htmlText",
    "fields": [
      { "target": "text", "from": "text" }
    ]
  },
  "fields": [
    { "target": "link",
      "from": "link",
      "extract": { "from": "text", "select": "a", "as": "attr", "attribute": "href" },
      "default": "#" },
    { "target": "image", "from": "image" },
    { "target": "imageResize", "from": "mobileimagestyle",
      "map": {
        "": "cover",
        "contain": "contain",
        "*": "cover"
      }, "default": "cover" },
    { "target": "title", "extract": { "from": "text", "select": "h1, h2, h3, h4", "as": "text" } },
    { "target": "cardType", "from": "mobilecardstyle",
      "map": { "one-line": "image-text-one-line", "below": "stacked" },
      "default": "overlay" },
    { "target": "subtitle",
      "extract": { "from": "text", "select": "p:not(:has(a)), li", "as": "text", "all": true },
      "nullable": true },
    { "target": "titleVariant", "const": "titleLarge" },
    { "target": "subtitleVariant", "const": "titleMedium" },
    { "target": "titleFontWeight", "const": "regular" },
    { "target": "subtitleFontWeight", "const": "regular" }
  ],
  "styles": [
    { "target": "color", "from": "textcolor", "type": "hexColor", "nullable": true }
  ]
}

