{
  "match": ["image", "picture"],
  "component": "image",
  "fields": [
    { "target": "image", "from": "image" },
    { "target": "link", "from": "link", "nullable": true },
    { "target": "fullWidth", "from": "fullWidth", "type": "boolean", "default": true },
    { "target": "imageResize", "from": "mobileimageresize", "default": "cover" }
  ],
  "styles": [
    { "target": "width", "from": "width", "nullable": true },
    { "target": "height", "from": "height", "nullable": true }
  ]
}
