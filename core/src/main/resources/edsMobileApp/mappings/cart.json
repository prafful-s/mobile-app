{
  "match": ["cart"],
  "component": "cartSummary",
  "skeleton": true,
  "ignoreExtras": ["*"],
  "fields": [
    { "target": "_cart", "const": true },
    { "target": "emptyCartEvent", "from": "mobileButtonEventOnEmptyCart", "type": "trimmedString"},
    { "target": "checkoutEvent", "from": "mobileButtonEventOnCheckout", "type": "trimmedString"},
    { "target": "checkoutLink", "from": "mobileRedirectUrl", "type": "trimmedString", "default": "checkout" },
    { "target": "label", "from": "label", "default": "TOTAL" },
    { "target": "totalLabel", "from": "totalLabel", "default": "TOTAL" },
    { "target": "subtotalLabel", "from": "subtotalLabel", "default": "SUBTOTAL" },
    { "target": "shippingLabel", "from": "shippingLabel", "default": "SHIPPING" },
    { "target": "discountLabel", "from": "discountLabel", "default": "DISCOUNT" },
    { "target": "promoCodeLabel", "from": "promoCodeLabel", "default": "PROMO CODE" },
    { "target": "emptyCartMessage", "from": "emptyCartMessage", "default": "Your cart is empty" },
    { "target": "promoMessage", "from": "promoMessage", "default": "Promo code applied" },
    { "target": "promoErrorMessage", "from": "promoErrorMessage", "default": "Invalid promo code" },
    { "target": "showDiscount", "from": "showdiscount", "type": "boolean", "default": true },
    { "target": "showPromoCode", "from": "showpromocode", "type": "boolean", "default": true },
    { "target": "showShippingCharge", "from": "showshippingcharge", "type": "boolean", "default": true },
    { "target": "configureDiscountCodes", "from": "configureDiscountCodes", "type": "boolean", "default": false },
    { "target": "discountCodes", "from": "discountCodes", "default": [] }
  ]
}
