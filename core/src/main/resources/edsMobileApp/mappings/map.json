{
  "match": ["map"],
  "component": "map",
  "skeleton": true,
  "ignoreExtras": ["*"],
  "fields": [
    { "target": "displayAs", "from": "mobileDisplayAs", "default": "fullMap" },
    { "target": "mapCoordinates", "from": "mobileMapCoordinates", "type": "mapCoordinates", "omitIfAbsent": true }
  ],
  "styles": [
    { "target": "color", "from": "mobileColor", "default": "blue" },
    { "target": "height", "from": "mobileHeight", "type": "number", "default": 500 },
    { "target": "locationColor", "from": "mobileLocationColor", "default": "green" }
  ]
}
