{
  "match": ["hero"],
  "component": "banner",
  "variants": [
    { "when": { "field": "herolayout", "equals": "image-right" }, "useRule": "card",
      "defaults": { "mobilecardstyle": "stacked" } },
    { "when": { "field": "herolayout", "equals": "image-left" }, "useRule": "card",
      "defaults": { "mobilecardstyle": "stacked" } }
  ],
  "fields": [
    { "target": "image", "from": "image" },
    { "target": "title", "extract": { "from": "text", "select": "h1, h2", "as": "text" } },
    { "target": "titleVariant", "const": "titleLarge" },
    { "target": "subtitle",
      "extract": { "from": "text", "select": "p:not(:has(a)), h3, h4, h5, h6", "as": "text", "all": true },
      "nullable": true },
    { "target": "buttonLabel",
      "extract": { "from": "text", "select": "a", "as": "text" }, "nullable": true },
    { "target": "buttonVariant", "from": "ctastyle",
      "map": { "button": "contained", "button-secondary": "contained-tonal", "link": "text", "*": "contained" },
      "default": "contained" },
    { "target": "imageResize", "from": "mobileimageresize", "default": "cover" },
    { "target": "linkTo",
      "extract": { "from": "text", "select": "a", "as": "attr", "attribute": "href" },
      "nullable": true },
    { "target": "showButton",
      "extract": { "from": "text", "select": "a", "as": "attr", "attribute": "href" },
      "type": "presence", "default": false },
    { "target": "showButton", "from": "mobileshowbutton", "type": "boolean" },
    { "target": "horizontalAlignment", "from": "herolayout",
      "map": { "image-left": "right", "image-background-text-right": "right", "*": "left" },
      "default": "left" },
    { "target": "verticalAlignment", "from": "verticalalignment", "default": "top" },
    { "target": "contentAlignment", "from": "alignment", "default": "left" },
    { "target": "horizontalAlignment", "from": "mobilehorizontalalignment" },
    { "target": "opacity", "from": "textoverlay", "type": "number",
      "map": { "true": 0.5, "false": 0 }, "default": 0.5 },
    { "target": "opacity", "from": "mobileopacity", "type": "number" }
  ],
  "styles": [
    { "target": "gap", "const": 8 }
  ]
}
