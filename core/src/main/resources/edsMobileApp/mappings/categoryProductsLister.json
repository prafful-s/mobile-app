{
  "match": ["category-products-lister"],
  "component": "list",
  "skeleton": true,
  "ignoreExtras": ["*"],
  "contentFragmentFolderRef": {
    "property": "folder",
    "collect": [
      { "fields": ["sku", "id"], "injectAs": "_items" },
      { "fields": ["category"], "injectAs": "_categories" }
    ]
  },
  "fields": [
    { "target": "items", "from": "_items", "default": [] },
    { "target": "filter", "first": ["mobilecategoryfilter", "_categories"], "type": "categoryRootRegex", "default": "" },
    { "target": "layout", "first": ["mobilelayout", "layout"],
      "map": { "horizontal": "horizontal", "vertical": "vertical/grid", "vertical/grid": "vertical/grid" },
      "default": "vertical/grid" },
    { "target": "sort", "first": ["mobilesort", "sort"], "default": "none" },
    { "target": "listType", "from": "listType", "default": "productList" },
    { "target": "textColor", "from": "textColor", "default": "#8B8B8B" },
    { "target": "itemsInRow", "first": ["mobileitemsinrow", "itemsInRow"], "type": "number", "default": 1 },
    { "target": "itemRenderer", "first": ["mobileitemrenderer", "mobilecardstyle", "itemRenderer"],
      "map": {
        "one-line": "image-text-one-line",
        "overlay": "overlay",
        "below": "stacked",
        "partial-overlay": "partial-overlay",
        "stacked": "stacked",
        "image-text-one-line": "image-text-one-line",
        "image": "image",
        "*": "image-text-one-line"
      }, "default": "image-text-one-line" },
    { "target": "imageResize", "first": ["mobileimagestyle", "imageResize", "imageResizeMode"],
      "map": { "contain": "contain", "cover": "cover", "*": "contain" }, "default": "contain" },
    { "target": "imageWidth", "first": ["mobileimagewidth", "imageWidth"],
      "type": "number", "default": 150 },
    { "target": "itemHeight", "first": ["mobileitemheight", "itemHeight"],
      "type": "number", "default": 150 },
    { "target": "filterProperty", "from": "filterProperty", "default": "Category" },
    { "target": "titleFontWeight", "from": "titleFontWeight", "default": "regular" },
    { "target": "subtitleFontWeight", "from": "subtitleFontWeight", "default": "light" }
  ]
}
