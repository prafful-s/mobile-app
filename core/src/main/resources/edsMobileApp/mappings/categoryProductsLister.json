{
  "match": ["category-products-lister"],
  "component": "list",
  "skeleton": true,
  "ignoreExtras": ["*"],
  "contentFragmentFolderRef": {
    "property": "folder",
    "collect": [
      { "fields": ["sku", "id"], "injectAs": "_items" },
      { "fields": ["category"], "injectAs": "_categories" }
    ]
  },
  "fields": [
    { "target": "items", "from": "_items", "default": [] },
    { "target": "filter", "from": "_categories", "type": "categoryRootRegex", "default": "" },
    { "target": "layout", "from": "mobilelayout", "default": "vertical/grid" },
    { "target": "sort", "from": "mobilesort", "default": "none" },
    { "target": "listType", "from": "listType", "default": "productList" },
    { "target": "textColor", "from": "textColor", "default": "#8B8B8B" },
    { "target": "itemsInRow", "from": "mobileitemsinrow", "type": "number", "default": 1 },
    { "target": "itemRenderer", "from": "mobileitemrenderer",
      "map": { "image-text-one-line": "image-text-one-line", "overlay": "overlay", "stacked": "stacked",
               "image": "image", "*": "image-text-one-line" },
      "default": "image-text-one-line" },
    { "target": "imageResize", "from": "mobileimagestyle",
      "map": { "contain": "contain", "cover": "cover", "*": "contain" }, "default": "contain" },
    { "target": "imageWidth", "from": "mobileimagewidth", "type": "number", "default": 150 },
    { "target": "itemHeight", "from": "mobileitemheight", "type": "number", "default": 150 },
    { "target": "filterProperty", "from": "filterProperty", "default": "Category" },
    { "target": "titleFontWeight", "from": "titleFontWeight", "default": "regular" },
    { "target": "subtitleFontWeight", "from": "subtitleFontWeight", "default": "light" }
  ]
}
