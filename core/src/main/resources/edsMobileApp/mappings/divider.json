{
  "match": ["divider", "separator"],
  "component": "divider",
  "skeleton": true,
  "fields": [
    { "target": "size", "from": "spacing", "map": { "small": "S", "medium": "M", "large": "L" }, "default": "S" },
    { "target": "length", "from": "spacing", "map": { "small": "S", "medium": "M", "large": "L" }, "default": "S" },
    { "target": "variant", "from": "variant", "default": "normal" },
    { "target": "showLine", "from": "style", "type": "boolean", "map": { "visible": true, "hidden": false }, "default": false },
    { "target": "alignment", "from": "alignment", "default": "center" },
    { "target": "orientation", "from": "orientation", "default": "vertical" },
    { "target": "horizontalInset", "from": "horizontalInset", "type": "boolean", "nullable": true }
  ]
}
