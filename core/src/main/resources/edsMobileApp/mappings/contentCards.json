{
  "match": ["content-card"],
  "component": "contentCards",
  "fields": [
    { "target": "surface", "from": "mobileSurface" }
  ],
  "styles": [
    { "target": "borderColor", "from": "mobileBorderColor" },
    { "target": "borderRadius", "from": "mobileBorderRadius", "type": "number", "default": 9 },
    { "target": "backgroundColor", "from": "mobileBackgroundColor" }
  ]
}
