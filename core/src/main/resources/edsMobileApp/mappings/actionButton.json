{
  "match": ["action-button"],
  "component": "button",
  "skeleton": true,
  "fields": [
    { "target": "label", "from": "label", "default": "" },
    { "target": "eventType", "from": "mobilebuttoneventtype" },
    { "target": "linkTo", "from": "link", "type": "path", "default": "" },
    { "target": "icon", "from": "mobileicon", "default": "" },
    { "target": "message", "from": "mobilemessage", "default": "" },
    { "target": "variant", "from": "mobilebuttonvariant", "default": "contained" },
    { "target": "alignment", "from": "mobilealignment", "default": "stretch" }
  ]
}
