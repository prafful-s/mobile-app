{
  "match": ["product-detail"],
  "component": "productCard",
  "variants": [
    { "when": { "field": "mobileappcustomproductdetails", "equals": "true" }, "useRule": "product-detail-image" }
  ],
  "skeleton": true,
  "ignoreExtras": ["*"],
  "fields": [
    { "target": "product", "type": "null" },
    { "target": "imageResize", "from": "mobileimageresize", "default": "contain" }
  ]
}
