<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dept.contentbridge</groupId>
        <artifactId>contentbridge</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>contentbridge.all</artifactId>
    <packaging>content-package</packaging>
    <name>ContentBridge - All</name>
    <description>Single deployable container package. This is the artifact Cloud Manager ships.</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.jackrabbit</groupId>
                <artifactId>filevault-package-maven-plugin</artifactId>
                <extensions>true</extensions>
                <configuration>
                    <group>com.dept.contentbridge</group>
                    <packageType>container</packageType>
                    <properties>
                        <cloudManagerTarget>all</cloudManagerTarget>
                    </properties>
                    <embeddeds>
                        <!-- The OSGi bundle lives here, not in ui.apps: a package of type
                             'application' is not allowed to carry bundles or configs. -->
                        <embedded>
                            <groupId>com.dept.contentbridge</groupId>
                            <artifactId>contentbridge.core</artifactId>
                            <target>/apps/contentbridge-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.dept.contentbridge</groupId>
                            <artifactId>contentbridge.ui.apps</artifactId>
                            <type>zip</type>
                            <target>/apps/contentbridge-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.dept.contentbridge</groupId>
                            <artifactId>contentbridge.ui.config</artifactId>
                            <type>zip</type>
                            <target>/apps/contentbridge-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.dept.contentbridge</groupId>
                            <artifactId>contentbridge.ui.content</artifactId>
                            <type>zip</type>
                            <target>/apps/contentbridge-packages/content/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobe.cq</groupId>
                            <artifactId>core.wcm.components.content</artifactId>
                            <type>zip</type>
                            <target>/apps/contentbridge-vendor-packages/application/install</target>
                        </embedded>
                        <embedded>
                            <groupId>com.adobe.cq</groupId>
                            <artifactId>core.wcm.components.config</artifactId>
                            <type>zip</type>
                            <target>/apps/contentbridge-vendor-packages/application/install</target>
                        </embedded>
                    </embeddeds>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.adobe.aem</groupId>
                <artifactId>aemanalyser-maven-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <execution>
                        <id>aem-analyser</id>
                        <goals>
                            <goal>project-analyse</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>autoInstallSinglePackage</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.day.jcr.vault</groupId>
                        <artifactId>content-package-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-package</id>
                                <goals><goal>install</goal></goals>
                                <configuration>
                                    <targetURL>http://${aem.host}:${aem.port}/crx/packmgr/service.jsp</targetURL>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>autoInstallSinglePackagePublish</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.day.jcr.vault</groupId>
                        <artifactId>content-package-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>install-package-publish</id>
                                <goals><goal>install</goal></goals>
                                <configuration>
                                    <targetURL>http://${aem.publish.host}:${aem.publish.port}/crx/packmgr/service.jsp</targetURL>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <dependencies>
        <dependency>
            <groupId>com.dept.contentbridge</groupId>
            <artifactId>contentbridge.core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.dept.contentbridge</groupId>
            <artifactId>contentbridge.ui.apps</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.dept.contentbridge</groupId>
            <artifactId>contentbridge.ui.config</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.dept.contentbridge</groupId>
            <artifactId>contentbridge.ui.content</artifactId>
            <version>${project.version}</version>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobe.cq</groupId>
            <artifactId>core.wcm.components.content</artifactId>
            <type>zip</type>
        </dependency>
        <dependency>
            <groupId>com.adobe.cq</groupId>
            <artifactId>core.wcm.components.config</artifactId>
            <type>zip</type>
        </dependency>
    </dependencies>
</project>
