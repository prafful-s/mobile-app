# ContentBridge virtual host.
#
# The JSON API is a plain GET on /content/<site>/api/<name>.json (any site, any endpoint name -
# the servlet binds by sling:resourceType, not a fixed path; see contentbridge_filters.any). The
# /apps/contentbridge/api.json form only works on author - publish denies anonymous /apps read
# regardless of what the dispatcher lets through.

<VirtualHost *:80>
    ServerName "publish"
    ServerAlias "contentbridge.local"
    ServerAlias "*.adobeaemcloud.net"
    ServerAlias "*.adobeaemcloud.com"

    <Directory />
        Options FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    # CORS for browser and mobile clients consuming the JSON contract. Covers both the working
    # publish path and the author-only /apps convenience path.
    <LocationMatch "^/(content/[^/]+/api/|apps/contentbridge/api)[^/]*\.json$">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, OPTIONS"
        Header always set Access-Control-Allow-Headers "Content-Type"
    </LocationMatch>

    <IfModule disp_apache2.c>
        ModMimeUsePathInfo On
        DispatcherUseProcessedURL On
        DispatcherPassError 400-404,500
    </IfModule>
</VirtualHost>
