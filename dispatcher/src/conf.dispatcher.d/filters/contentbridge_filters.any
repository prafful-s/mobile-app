# ContentBridge filter rules.
#
# The default deny-all from the SDK stays in force; these rules open exactly the two things the
# API needs and nothing more.

# The read API. Resource-type bound, so it is requested as a real resource with a .json extension.
/0100 {
  /type "allow"
  /method "GET"
  /path "/apps/contentbridge/api"
  /extension "json"
  /query "*"
}

# Published DAM renditions referenced from the JSON payload.
/0110 {
  /type "allow"
  /method "GET"
  /path "/content/dam/contentbridge/*"
  /extension '(?i)(jpe?g|png|gif|svg|webp)'
}
