# ContentBridge cache rules.

/rules {
  # Cache the JSON responses. The exporter also sets Cache-Control, so the TTL is honoured by the
  # CDN as well as by the dispatcher.
  #
  # /content/*/api/*.json is the path that actually serves on publish (see
  # contentbridge_filters.any and the vhost's LocationMatch); /apps/contentbridge/api.json is kept
  # for author-side use only.
  /0000 {
    /glob "/content/*/api/*.json*"
    /type "allow"
  }
  /0001 {
    /glob "/apps/contentbridge/api.json*"
    /type "allow"
  }
}

/invalidate {
  /0000 {
    /glob "*"
    /type "deny"
  }
  # Any site under /content, not just this repo's own demo content at /content/contentbridge -
  # the API exports whatever site an author points it at (see contentbridge_filters.any).
  /0001 {
    /glob "/content/*"
    /type "allow"
  }
}
